{
  "name": "present",
  "version": "1.0.0",
  "description": "Research presentation support: grant writing, budget planning, timeline management, funding analysis, and academic talks",
  "task_type": "present",
  "dependencies": [
    "core",
    "slidev"
  ],
  "provides": {
    "agents": [
      "grant-agent.md",
      "budget-agent.md",
      "timeline-agent.md",
      "funds-agent.md",
      "slides-research-agent.md",
      "pptx-assembly-agent.md",
      "slidev-assembly-agent.md",
      "slide-planner-agent.md",
      "slide-critic-agent.md"
    ],
    "skills": [
      "skill-grant",
      "skill-budget",
      "skill-timeline",
      "skill-funds",
      "skill-slides",
      "skill-slide-planning",
      "skill-slide-critic"
    ],
    "commands": [
      "grant.md",
      "budget.md",
      "timeline.md",
      "funds.md",
      "slides.md"
    ],
    "rules": [],
    "context": [
      "project/present"
    ],
    "scripts": [],
    "hooks": []
  },
  "routing_agents": {
    "research": {
      "present": "grant-agent",
      "present:grant": "grant-agent",
      "present:budget": "budget-agent",
      "present:timeline": "timeline-agent",
      "present:funds": "funds-agent",
      "present:slides": "slides-research-agent"
    },
    "plan": {
      "present": "planner-agent",
      "present:grant": "planner-agent",
      "present:budget": "planner-agent",
      "present:timeline": "planner-agent",
      "present:funds": "planner-agent",
      "present:slides": "slide-planner-agent",
      "slides": "slide-planner-agent"
    },
    "implement": {
      "present": "grant-agent",
      "present:grant": "grant-agent",
      "present:budget": "budget-agent",
      "present:timeline": "timeline-agent",
      "present:funds": "funds-agent",
      "present:slides": "slidev-assembly-agent"
    },
    "critique": {
      "present:slides": "slide-critic-agent"
    }
  },
  "merge_targets": {
    "claudemd": {
      "source": "EXTENSION.md",
      "target": ".claude/CLAUDE.md",
      "section_id": "extension_present"
    },
    "settings": {
      "source": "settings-fragment.json",
      "target": ".claude/settings.local.json"
    },
    "index": {
      "source": "index-entries.json",
      "target": ".claude/context/index.json"
    },
    "opencode_json": {
      "source": "opencode-agents.json",
      "target": "opencode.json"
    }
  }
}
