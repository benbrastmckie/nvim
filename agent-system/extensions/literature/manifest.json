{
  "name": "literature",
  "version": "2.0.0",
  "description": "Unified literature management: scan, convert PDFs/DJVUs, maintain index.json, search/import from Zotero, and manage per-repo sub-index. Replaces separate zotero extension.",
  "dependencies": [
    "core"
  ],
  "routing_exempt": true,
  "provides": {
    "agents": [
      "literature-agent.md"
    ],
    "commands": [
      "literature.md",
      "cite.md"
    ],
    "skills": [
      "skill-literature",
      "skill-cite"
    ],
    "context": [
      "project/literature",
      "guides"
    ],
    "scripts": [
      "zotero-search.sh",
      "zotero-generate-export.sh",
      "zotero-export-status.sh",
      "zotero-export-freshness.sh",
      "zotero-resolve-sqlite-path.sh",
      "cite-extract.sh",
      "zotero-read.sh",
      "zotero-write.sh",
      "zotero-setup.sh",
      "zotero-chunk.sh",
      "zotero-attach-chunks.sh",
      "literature-briefing.sh",
      "literature-create-setup-task.sh",
      "test-lit-pipeline.sh",
      "literature-discover.sh",
      "literature-ingest.sh",
      "literature-ingest-online.sh",
      "literature-search.sh",
      "literature-fidelity-audit.sh",
      "literature-doc-key.sh",
      "literature-build-index.sh",
      "literature-convert.sh",
      "literature_combining_overlay.py",
      "literature_quality_gate.py",
      "literature_combining_detect.py",
      "literature-combining-audit.sh",
      "literature-repair-combining.sh",
      "literature-chunk.sh",
      "literature-normalize-authors.sh",
      "literature-schema.sql",
      "literature-briefing-invoke.sh",
      "literature-lit-flag-resolve.sh",
      "literature-coverage-delta.sh",
      "literature-term-match.sh",
      "literature-audit.sh",
      "literature-pyenv-provision.sh",
      "zotero-resolve-pdf.sh",
      ".zotero-title-sim.py",
      "tests/generate-test-fixtures.py",
      "tests/test-literature-convert.sh",
      "tests/test-literature-build-index.sh",
      "tests/test-quality-gate-notation.sh",
      "tests/curl-stub.sh",
      "tests/test-literature-discover-tier3.sh",
      "tests/test-title-sim-dedup.sh",
      "tests/fixtures/tier3-crossref-200.json",
      "tests/fixtures/tier3-golden-baseline.json",
      "tests/fixtures/tier3-openalex-200.json",
      "tests/fixtures/tier3-semanticscholar-200.json",
      "tests/fixtures/tier3-semanticscholar-empty-200.json",
      "tests/fixtures/tier3-unpaywall-200.json"
    ]
  },
  "merge_targets": {
    "claudemd": {
      "source": "merge-sources/claudemd.md",
      "target": ".claude/CLAUDE.md",
      "section_id": "extension_literature"
    },
    "index": {
      "source": "index-entries.json",
      "target": ".claude/context/index.json"
    }
  }
}
