{
  "name": "sapience",
  "version": "1.0.0",
  "description": "Permission grants and orientation docs for the hosted Sapience knowledge vault (app.spnc.ai): closes the MCP write-tool permission gap and documents the postflight wrapup instruction and the vault's review-gate/transcript-filter boundaries",
  "dependencies": ["core"],
  "routing_exempt": true,
  "provides": {
    "agents": [],
    "commands": [],
    "skills": [],
    "rules": ["sapience-write-path.md"],
    "scripts": [
      "sapience-remember.sh",
      "sapience-retrieve.sh",
      "setup-sapience-mcp.sh",
      "tests/test-sapience-capture.sh",
      "tests/test-sapience-mcp-registration.sh"
    ],
    "hooks": [
      "sapience-mcp-register-project.sh"
    ],
    "data": [],
    "context": ["project/sapience"]
  },
  "merge_targets": {
    "claudemd": {
      "source": "EXTENSION.md",
      "target": ".claude/CLAUDE.md",
      "section_id": "extension_sapience"
    },
    "index": {
      "source": "index-entries.json",
      "target": ".claude/context/index.json"
    },
    "settings": {
      "source": "settings-fragment.json",
      "target": ".claude/settings.local.json"
    }
  }
}
