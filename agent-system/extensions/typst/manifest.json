{
  "name": "typst",
  "version": "1.0.0",
  "description": "Typst document development with single-pass compilation",
  "task_type": "typst",
  "dependencies": [
    "core"
  ],
  "provides": {
    "agents": [
      "typst-research-agent.md",
      "typst-implementation-agent.md"
    ],
    "skills": [
      "skill-typst-research",
      "skill-typst-implementation"
    ],
    "commands": [],
    "rules": [],
    "context": [
      "project/typst"
    ],
    "scripts": [
      "typst-element-lint.sh",
      "tests/test-typst-element-lint.sh",
      "chapter-quality-check.sh",
      "tests/test-chapter-quality-check.sh"
    ],
    "hooks": []
  },
  "routing_agents": {
    "research": {
      "typst": "typst-research-agent"
    },
    "plan": {
      "typst": "planner-agent"
    },
    "implement": {
      "typst": "typst-implementation-agent"
    }
  },
  "keyword_overrides": {
    "typst": {
      "keywords": [
        "typst formatting",
        "typst compile",
        "typst compilation",
        "typst package",
        "typst template",
        "typst style",
        "typst layout",
        "fletcher diagram",
        "typst chapter",
        "typst chapters",
        "typst manual",
        "chapter quality",
        "chapter prose"
      ],
      "aliases": []
    }
  },
  "merge_targets": {
    "claudemd": {
      "source": "EXTENSION.md",
      "target": ".claude/CLAUDE.md",
      "section_id": "extension_typst"
    },
    "index": {
      "source": "index-entries.json",
      "target": ".claude/context/index.json"
    },
    "opencode_json": {
      "source": "opencode-agents.json",
      "target": "opencode.json"
    }
  }
}
