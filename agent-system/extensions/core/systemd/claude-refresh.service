[Unit]
Description=Claude Code orphaned process refresh
Documentation=https://github.com/anthropics/claude-code
#
# Deploy-path ruling: ExecStart below targets the gitignored, regenerated
# deploy tree (%h/.config/nvim/.claude/), not the source store. On a machine
# where that tree has not yet been generated (or has been removed), the
# ConditionPathExists directive below makes systemd log a clean informational
# skip for that run instead of failing the unit hourly into `systemctl
# --failed`. This was chosen over the two bare alternatives -- leaving
# ExecStart unconditional, or merely documenting the dependency without
# enforcing it -- because it is the only option that actually changes the
# failure mode rather than only describing it. Point ConditionPathExists at
# your own deploy path if you installed this unit somewhere other than the
# default; it must match ExecStart's path character-for-character.
ConditionPathExists=%h/.config/nvim/.claude/scripts/claude-refresh.sh

[Service]
Type=oneshot
# Use the script from the project
# Update this path to match your installation
#
# Policy: this unattended, hourly, no-confirmation cadence is intentionally
# non-destructive -- it reports/logs found orphans rather than terminating them.
# A matcher bug must never again be amplifiable into unattended hourly kills,
# regardless of how correct the matcher looks at review time. --force remains
# available as a deliberate opt-in via manual invocation or a hand-edited unit.
#
# New-passes ruling (confirmed at code level, not merely asserted): as of this
# writing, claude-refresh.sh's main() calls exactly five pass functions --
# run_claude_pass, run_lean_pass, run_build_waiter_pass, run_zombie_pass,
# run_mcp_fanout_pass -- all unconditionally, in one fixed sequence, all
# threading the single $FORCE/$DRY_RUN pair this ExecStart line supplies.
# Four of the five stay non-destructive under this unit for the ORIGINAL
# reason: the zombie and MCP-fan-out passes never terminate anything under any
# flag (they have no --force branch at all), and the Lean LSP pass terminates
# only under --force, which this unit never passes.
#
# The fifth, run_build_waiter_pass, is DIFFERENT and was re-derived rather than
# assumed safe: its destructive trigger is the absence of --dry-run, not the
# presence of --force -- it is the first pass in claude-refresh.sh whose
# termination is not gated by $FORCE at all (see SKILL.md/refresh.md's Process
# Safety sections for the full rationale). This unit stays non-destructive for
# this pass too, but via a DIFFERENT mechanism than the other four: because
# ExecStart below always passes --dry-run, and --dry-run is this pass's own
# sole non-destructive gate, an hourly run always takes this pass's report-only
# branch. A future pass follows the four-pass-era rule (needs no flag/ExecStart
# of its own) only if it is wired into main()'s unconditional sequence AND is
# gated by --dry-run/--force the same way the existing five are; if a future
# pass is instead independently gated (its own flag, its own ExecStart, or a
# destructive trigger this ExecStart line does not already supply), re-derive
# this ruling rather than assuming it still holds. This reasoning is recorded
# here so a future reader does not reopen it; see SKILL.md/refresh.md for the
# full per-pass inventory.
#
# Scope note: the file/spec cleanup passes (orphaned postflight markers, stale
# task locks, stale session-scoped orchestration files, stale session registry
# entries, stale .backup files, and the ~/.claude/ directory cleanup) are
# /refresh-only -- this unit's ExecStart never reaches any of them. The ruling
# above is scoped to claude-refresh.sh's five internal passes, not to the full
# eleven-item surface-level inventory.
ExecStart=%h/.config/nvim/.claude/scripts/claude-refresh.sh --dry-run
# Alternatively, if installed system-wide:
# ExecStart=/usr/local/bin/claude-refresh.sh --dry-run

# Run with normal user permissions
User=%u

# Environment
Environment=HOME=%h
Environment=PATH=/usr/bin:/bin

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-refresh

[Install]
WantedBy=default.target
